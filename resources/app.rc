#include <windows.h>

#include "resource.h"

IDR_APP_MANIFEST RT_MANIFEST "app.manifest"
IDI_APP_ICON ICON "quickdraw.ico"

IDR_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Quickdraw"
            VALUE "FileDescription", "Quickdraw monitor mode switcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Quickdraw"
            VALUE "OriginalFilename", "Quickdraw.exe"
            VALUE "ProductName", "Quickdraw"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 286, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Quickdraw Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Start Quickdraw with Windows", IDC_START_WITH_WINDOWS,
            "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 180, 12
    LTEXT "Keep-changes countdown:", -1, 12, 34, 104, 10
    COMBOBOX IDC_CONFIRM_TIMEOUT, 120, 31, 74, 80,
             CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX "Presets", -1, 8, 52, 270, 144
    LISTBOX IDC_PRESET_LIST, 16, 66, 122, 92,
            LBS_NOTIFY | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT "Name:", -1, 148, 68, 34, 10
    EDITTEXT IDC_PRESET_NAME, 148, 80, 120, 14,
             ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Save current as", IDC_PRESET_SAVE, 148, 101, 120, 14
    PUSHBUTTON "Rename selected", IDC_PRESET_RENAME, 148, 120, 120, 14
    PUSHBUTTON "Update from current", IDC_PRESET_UPDATE, 148, 139, 120, 14
    PUSHBUTTON "Delete selected", IDC_PRESET_DELETE, 148, 158, 120, 14
    LTEXT "Presets store resolution and refresh rate only.", -1,
          16, 177, 244, 10

    DEFPUSHBUTTON "Save and close", IDOK, 174, 207, 70, 14
    PUSHBUTTON "Cancel", IDCANCEL, 248, 207, 30, 14
END
